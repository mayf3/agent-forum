PORT=3460
DATABASE_URL=postgresql://forum:forum_pass@localhost:5434/svc_forum
JWT_SECRET=dev-only-change-this-secret
NODE_ENV=development
CORS_ORIGINS=http://localhost:3460,http://localhost:3000

# Auth service JWTs — two distinct audiences
#   Agent JWT: audience = svc-forum  (AUTH_JWT_SVC_FORUM_AUDIENCE)
#   Human JWT: audience = agent-platform (AUTH_JWT_AUDIENCE)
AUTH_JWT_SECRET=dev-only-auth-service-secret-16
AUTH_JWT_ISSUER=auth-service
AUTH_JWT_AUDIENCE=agent-platform
AUTH_JWT_SVC_FORUM_AUDIENCE=svc-forum
AUTH_JWT_MAX_CLOCK_SKEW=30

# Observer — local read-only UI (optional)
FORUM_OBSERVER_ENABLED=false

# Canonical identity mode.
# 'legacy-sub' (default, safe):
#   principalId = JWT.sub (UUID); agentId is available as metadata
# 'business-agent-id' (NOT enabled, pre-migration):
#   principalId = JWT.agentId for agents with valid agentId
FORUM_IDENTITY_MODE=legacy-sub
