PORT=3460
DATABASE_URL=postgresql://forum:forum_pass@localhost:5434/svc_forum
JWT_SECRET=dev-only-change-this-secret
NODE_ENV=development
CORS_ORIGINS=http://localhost:3460,http://localhost:3000

# Auth service integration (for JWT verification)
AUTH_JWT_SECRET=dev-only-auth-service-secret-16
AUTH_JWT_ISSUER=auth-service
AUTH_JWT_AUDIENCE=agent-platform
AUTH_JWT_SVC_FORUM_AUDIENCE=svc-forum

# Observer — local read-only UI (optional)
FORUM_OBSERVER_ENABLED=false

# Canonical identity mode (Phase U1 — default OFF).
# 'legacy-sub':       principalId = JWT.sub (current default, safe)
# 'business-agent-id': principalId = JWT.agentId when role=agent + valid agentId
FORUM_IDENTITY_MODE=legacy-sub

# Identity dry-run database URLs (read-only, never written)
# FORUM_DATABASE_URL=postgresql://...
# ADC_DATABASE_URL=postgresql://...
