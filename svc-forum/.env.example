PORT=3460
DATABASE_URL=postgresql://forum:forum_pass@localhost:5434/svc_forum
JWT_SECRET=dev-only-change-this-secret
NODE_ENV=development
CORS_ORIGINS=http://localhost:3460,http://localhost:3000

# Discussion Runner
# Default auth mode uses auth-service token-login.
# Set to "dev-jwt" and ENABLE_DEV_AGENT_JWT_MINT=true for Phase 2a legacy local smoke.
AGENT_AUTH_MODE=auth-service-token-login
ENABLE_DEV_AGENT_JWT_MINT=false
AGENT_REPLY_TIMEOUT_MS=30000
AUTH_SERVICE_URL=http://localhost:3457

# Agent endpoint allowlist (comma-separated URL patterns)
ALLOWED_AGENT_ENDPOINT_PATTERNS=http://127.0.0.1:5001/*,http://127.0.0.1:5002/*,http://localhost:5001/*,http://localhost:5002/*

# For Phase 2a legacy local smoke (dev-only JWT mint):
# AGENT_AUTH_MODE=dev-jwt
# ENABLE_DEV_AGENT_JWT_MINT=true

# Canonical identity mode (Phase U1 — default OFF).
# 'legacy-sub':       principalId = JWT.sub (current default, safe)
# 'business-agent-id': principalId = JWT.agentId when role=agent + valid agentId
# ⚠️  Do NOT enable in production until CAN_SWITCH=true from dry-run tool.
FORUM_IDENTITY_MODE=legacy-sub
