generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ForumThread {
  id                 String               @id @default(uuid()) @db.Uuid
  title              String
  type               String               @default("discussion")
  status             String               @default("open")
  contextType        String?
  contextId          String?
  pipeline           String?
  layer              String?
  tags               String[]             @default([])
  pinned             Boolean              @default(false)
  featured           Boolean              @default(false)
  messageCount       Int                  @default(0)
  viewCount          Int                  @default(0)
  lastMessageAt      DateTime?
  createdById        String
  createdByName      String
  createdByType      String               @default("agent")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  resolvedAt         DateTime?
  resolvedById       String?
  resolvedByName     String?
  creatorPrincipalId String?              @map("creator_principal_id") @db.Uuid
  visibilityState    String?              @map("visibility_state")
  currentRevision    Int?                 @map("current_revision")
  creatorPrincipal   ForumPrincipal?      @relation("ForumThreadCreatorPrincipal", fields: [creatorPrincipalId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "forum_threads_creator_principal_fk")
  currentRevisionRow ForumThreadRevision? @relation("ForumThreadCurrentRevision", fields: [id, currentRevision], references: [threadId, revision], onDelete: Restrict, onUpdate: Restrict, map: "forum_threads_current_revision_fk")

  participants       ForumThreadParticipant[]
  messages           ForumThreadMessage[]
  snapshots          ForumContextSnapshot[]
  outcomes           ForumOutcome[]
  views              ForumThreadView[]
  auditEvents        ForumAuditEvent[]
  participationFacts ForumParticipation[]
  watchSubscriptions ForumWatchSubscription[]
  readStates         ForumReadState[]
  notificationFacts  ForumNotificationFact[]
  revisions          ForumThreadRevision[]    @relation("ForumThreadRevisions")

  @@index([status])
  @@index([type])
  @@index([contextType, contextId])
  @@index([pipeline])
  @@index([lastMessageAt])
  @@index([pinned])
  @@index([featured])
  @@index([viewCount])
  @@map("forum_threads")
}

// ─── Forum Thread View (read tracking, dedup per principal) ────────────────
//
// viewCount on ForumThread is a cached counter; this table records which
// principals have viewed a thread so the same principal counts only once.
// AC#1: viewCount returned on detail & list; AC#4: read-only for members,
// anti-abuse controlled server-side (dedup + rate limit).

model ForumThreadView {
  id                String          @id @default(uuid()) @db.Uuid
  threadId          String          @db.Uuid
  thread            ForumThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  principalId       String          @map("principal_id")
  viewedAt          DateTime        @default(now()) @map("viewed_at")
  viewerPrincipalId String?         @map("viewer_principal_id") @db.Uuid
  viewerPrincipal   ForumPrincipal? @relation("ForumThreadViewViewerPrincipal", fields: [viewerPrincipalId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "forum_thread_views_viewer_principal_fk")

  @@unique([threadId, principalId])
  @@index([threadId])
  @@map("forum_thread_views")
}

model ForumThreadParticipant {
  id         String      @id @default(uuid()) @db.Uuid
  threadId   String      @db.Uuid
  thread     ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  agentId    String
  agentName  String
  role       String      @default("member")
  status     String      @default("invited")
  lastReadAt DateTime?
  joinedAt   DateTime    @default(now())
  leftAt     DateTime?

  reviewWaivedAt     DateTime?
  reviewWaivedById   String?
  reviewWaiverReason String?

  @@unique([threadId, agentId])
  @@map("forum_participants")
}

model ForumThreadMessage {
  id                 String          @id @default(uuid()) @db.Uuid
  threadId           String          @db.Uuid
  thread             ForumThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  parentId           String?         @db.Uuid
  seq                Int
  authorId           String
  authorName         String
  authorType         String          @default("agent")
  kind               String          @default("comment")
  content            String          @db.Text
  mentions           String[]        @default([])
  attachments        Json?
  metadata           Json?
  editedAt           DateTime?
  deletedAt          DateTime?
  createdAt          DateTime        @default(now())
  authorPrincipalId  String?         @map("author_principal_id") @db.Uuid
  discussionRevision Int?            @map("discussion_revision")
  authorPrincipal    ForumPrincipal? @relation("ForumMessageAuthorPrincipal", fields: [authorPrincipalId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "forum_messages_author_principal_fk")

  reactions         ForumReaction[]
  mentionFacts      ForumMention[]
  notificationFacts ForumNotificationFact[]

  @@index([threadId, seq])
  @@index([threadId, createdAt])
  @@index([authorId])
  @@index([kind])
  @@index([parentId])
  @@map("forum_messages")
}

model ForumContextSnapshot {
  id                 String          @id @default(uuid()) @db.Uuid
  threadId           String          @db.Uuid
  thread             ForumThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  snapshotType       String          @default("thread_creation")
  sourceType         String
  sourceRef          String
  title              String
  excerptMd          String?         @db.Text
  contentHash        String?
  snapshot           Json?
  takenById          String
  takenByName        String
  takenAt            DateTime        @default(now())
  note               String?
  takenByPrincipalId String?         @map("taken_by_principal_id") @db.Uuid
  discussionRevision Int?            @map("discussion_revision")
  takenByPrincipal   ForumPrincipal? @relation("ForumContextSnapshotTakenByPrincipal", fields: [takenByPrincipalId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "forum_context_snapshots_taken_by_principal_fk")

  @@index([threadId])
  @@index([sourceType, sourceRef])
  @@map("forum_context_snapshots")
}

model ForumOutcome {
  id                   String          @id @default(uuid()) @db.Uuid
  threadId             String          @db.Uuid
  thread               ForumThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  summaryMd            String          @db.Text
  decisionsJson        Json?
  actionItemsJson      Json?
  rejectedOptionsJson  Json?
  openQuestionsJson    Json?
  writebackTargetType  String?
  writebackTargetRef   String?
  createdById          String
  createdByName        String
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  createdByPrincipalId String?         @map("created_by_principal_id") @db.Uuid
  authorityKind        String?         @map("authority_kind")
  createdByPrincipal   ForumPrincipal? @relation("ForumOutcomeCreatedByPrincipal", fields: [createdByPrincipalId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "forum_outcomes_created_by_principal_fk")

  @@index([threadId])
  @@map("forum_outcomes")
}

// ─── Forum Principal (Unified Shadow Identity / JIT) ──────────────────────
//
// Maps auth-service JWT.sub to a local Forum identity.
// Created on first valid agent JWT access (JIT).
// authSubject is the global identity primary key.
// agentId is a stable business alias — must be unique if present.

model ForumPrincipal {
  id            String   @id @default(uuid()) @db.Uuid
  authSubject   String   @unique @map("auth_subject")
  principalType String   @default("agent")
  agentId       String?  @unique @map("agent_id")
  displayName   String?
  source        String   @default("jit")
  status        String   @default("active")
  firstSeenAt   DateTime @default(now()) @map("first_seen_at")
  lastSeenAt    DateTime @default(now()) @map("last_seen_at")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  candidateMigrationEvidence   MigrationLegacyEvidence[] @relation("MigrationEvidenceCandidatePrincipal")
  resolvedMigrationQuarantines MigrationQuarantine[]     @relation("MigrationQuarantineResolvedByPrincipal")
  auditEvents                  ForumAuditEvent[]
  aliases                      ForumPrincipalAlias[]
  createdThreads               ForumThread[]             @relation("ForumThreadCreatorPrincipal")
  authoredMessages             ForumThreadMessage[]      @relation("ForumMessageAuthorPrincipal")
  threadViews                  ForumThreadView[]         @relation("ForumThreadViewViewerPrincipal")
  createdOutcomes              ForumOutcome[]            @relation("ForumOutcomeCreatedByPrincipal")
  takenContextSnapshots        ForumContextSnapshot[]    @relation("ForumContextSnapshotTakenByPrincipal")
  submittedReports             ForumReport[]             @relation("ForumReportReporterPrincipal")
  handledReports               ForumReport[]             @relation("ForumReportHandledByPrincipal")
  actedReactions               ForumReaction[]           @relation("ForumReactionActorPrincipal")
  participationFacts           ForumParticipation[]
  watchSubscriptions           ForumWatchSubscription[]
  readStates                   ForumReadState[]
  mentionsReceived             ForumMention[]
  notificationFacts            ForumNotificationFact[]
  openedThreadRevisions        ForumThreadRevision[]     @relation("ForumThreadRevisionOpenedBy")
  resolvedThreadRevisions      ForumThreadRevision[]     @relation("ForumThreadRevisionResolvedBy")

  @@index([status])
  @@index([principalType])
  @@map("forum_principals")
}

model ForumPrincipalAlias {
  id          String    @id @default(uuid()) @db.Uuid
  principalId String    @map("principal_id") @db.Uuid
  namespace   String
  value       String
  firstSeenAt DateTime  @map("first_seen_at") @db.Timestamptz(3)
  retiredAt   DateTime? @map("retired_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  principal ForumPrincipal @relation(fields: [principalId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([namespace, value])
  @@index([principalId, namespace])
  @@map("forum_principal_aliases")
}

// ─── Forum Report (Moderation Queue) ──────────────────────────────────────
//
// Users report threads/messages; moderators (forum.moderate scope) process the
// queue. A reporter may only report a given target once — enforced by the
// @@unique([targetType, targetId, reporterId]) database constraint (AC#3).

model ForumReport {
  id                   String          @id @default(uuid()) @db.Uuid
  targetType           String          @map("target_type") // "thread" | "message"
  targetId             String          @map("target_id") @db.Uuid
  reporterId           String          @map("reporter_id")
  reporterName         String          @map("reporter_name")
  reason               String // spam | abuse | off_topic | violation | other — required
  note                 String?         @db.Text // optional supporting explanation
  status               String          @default("pending") // pending | ignored | warned | deleted
  handledById          String?         @map("handled_by_id")
  handledByName        String?         @map("handled_by_name")
  handledAt            DateTime?       @map("handled_at")
  handleNote           String?         @map("handle_note") @db.Text
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  reporterPrincipalId  String?         @map("reporter_principal_id") @db.Uuid
  handledByPrincipalId String?         @map("handled_by_principal_id") @db.Uuid
  reporterPrincipal    ForumPrincipal? @relation("ForumReportReporterPrincipal", fields: [reporterPrincipalId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "forum_reports_reporter_principal_fk")
  handledByPrincipal   ForumPrincipal? @relation("ForumReportHandledByPrincipal", fields: [handledByPrincipalId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "forum_reports_handled_by_principal_fk")

  @@unique([targetType, targetId, reporterId])
  @@index([status])
  @@index([targetType, targetId])
  @@map("forum_reports")
}

// ─── Forum Reaction (message-level likes/reactions) ────────────────────────
//
// AC#1: same agent on the same message counts once per emoji — enforced by
// @@unique([messageId, principalId, emoji]). AC#2: list/detail endpoints
// return aggregated reactions (emoji + count + deduped principal list).
// AC#3: reaction changes surface in my-updates (derived notification).
// AC#4: reuses existing forum.read/forum.write scopes — no new scope.

model ForumReaction {
  id                String                  @id @default(uuid()) @db.Uuid
  messageId         String                  @map("message_id") @db.Uuid
  message           ForumThreadMessage      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  threadId          String                  @map("thread_id") @db.Uuid // denormalized for query convenience
  principalId       String                  @map("principal_id")
  principalName     String                  @map("principal_name")
  emoji             String
  createdAt         DateTime                @default(now()) @map("created_at")
  actorPrincipalId  String?                 @map("actor_principal_id") @db.Uuid
  actorPrincipal    ForumPrincipal?         @relation("ForumReactionActorPrincipal", fields: [actorPrincipalId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "forum_reactions_actor_principal_fk")
  notificationFacts ForumNotificationFact[]

  @@unique([messageId, principalId, emoji])
  @@index([messageId])
  @@index([threadId])
  @@map("forum_reactions")
}

model MigrationRun {
  id                   String    @id @default(uuid()) @db.Uuid
  sourceCommit         String    @map("source_commit")
  sourceSchemaRevision String    @map("source_schema_revision")
  targetCommit         String    @map("target_commit")
  targetSchemaRevision String    @map("target_schema_revision")
  environment          String
  datasetId            String    @map("dataset_id")
  snapshotAt           DateTime  @map("snapshot_at") @db.Timestamptz(3)
  policyId             String    @map("policy_id")
  phase                String
  runIdentityKey       String    @map("run_identity_key")
  attempt              Int
  status               String
  startedAt            DateTime  @map("started_at") @db.Timestamptz(3)
  finishedAt           DateTime? @map("finished_at") @db.Timestamptz(3)
  rollbackReference    String?   @map("rollback_reference")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  legacyEvidence    MigrationLegacyEvidence[]
  validationResults MigrationValidationResult[]

  @@unique([runIdentityKey, attempt])
  @@map("forum_migration_runs")
}

model MigrationLegacyEvidence {
  id                   String   @id @default(uuid()) @db.Uuid
  migrationRunId       String   @map("migration_run_id") @db.Uuid
  sourceTable          String   @map("source_table")
  sourceRowReference   String   @map("source_row_reference")
  sourceRowHash        Bytes    @map("source_row_hash") @db.ByteA
  sourceNamespace      String?  @map("source_namespace")
  candidatePrincipalId String?  @map("candidate_principal_id") @db.Uuid
  classification       String
  safePayload          Json     @map("safe_payload")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  migrationRun       MigrationRun             @relation(fields: [migrationRunId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  candidatePrincipal ForumPrincipal?          @relation("MigrationEvidenceCandidatePrincipal", fields: [candidatePrincipalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fieldDecisions     MigrationFieldDecision[]
  quarantine         MigrationQuarantine?
  participationFacts ForumParticipation[]
  watchSubscriptions ForumWatchSubscription[]
  readStates         ForumReadState[]

  @@unique([migrationRunId, sourceTable, sourceRowReference])
  @@map("forum_migration_legacy_evidence")
}

model MigrationFieldDecision {
  id                String   @id @default(uuid()) @db.Uuid
  legacyEvidenceId  String   @map("legacy_evidence_id") @db.Uuid
  fieldName         String   @map("field_name")
  classification    String
  sourceValuesSafe  Json     @map("source_values_safe")
  selectedValueSafe Json?    @map("selected_value_safe")
  reasonCode        String   @map("reason_code")
  decidedByPolicy   String   @map("decided_by_policy")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  legacyEvidence MigrationLegacyEvidence @relation(fields: [legacyEvidenceId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([legacyEvidenceId, fieldName])
  @@map("forum_migration_field_decisions")
}

model MigrationQuarantine {
  id                          String    @id @default(uuid()) @db.Uuid
  legacyEvidenceId            String    @unique @map("legacy_evidence_id") @db.Uuid
  category                    String
  authorityEffect             String    @map("authority_effect")
  status                      String
  reasonCode                  String    @map("reason_code")
  reclassificationRequirement String    @map("reclassification_requirement")
  createdAt                   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt                  DateTime? @map("resolved_at") @db.Timestamptz(3)
  resolvedByPrincipalId       String?   @map("resolved_by_principal_id") @db.Uuid

  legacyEvidence      MigrationLegacyEvidence @relation(fields: [legacyEvidenceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resolvedByPrincipal ForumPrincipal?         @relation("MigrationQuarantineResolvedByPrincipal", fields: [resolvedByPrincipalId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("forum_migration_quarantines")
}

model MigrationValidationResult {
  id                String   @id @default(uuid()) @db.Uuid
  migrationRunId    String   @map("migration_run_id") @db.Uuid
  checkId           String   @map("check_id")
  contractId        String?  @map("contract_id")
  required          Boolean
  expected          Json
  actual            Json
  result            String
  evidenceReference String   @map("evidence_reference")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  migrationRun MigrationRun @relation(fields: [migrationRunId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([migrationRunId, checkId])
  @@map("forum_migration_validation_results")
}

// ─── Phase 2 subscription storage (empty; no runtime readers/writers) ──────

model ForumParticipation {
  id                 String    @id @default(uuid()) @db.Uuid
  threadId           String    @map("thread_id") @db.Uuid
  principalId        String    @map("principal_id") @db.Uuid
  presentationRole   String?   @map("presentation_role")
  presentationStatus String?   @map("presentation_status")
  joinedAt           DateTime? @map("joined_at") @db.Timestamptz(3)
  leftAt             DateTime? @map("left_at") @db.Timestamptz(3)
  factState          String    @map("fact_state")
  provenance         String
  legacyEvidenceId   String?   @map("legacy_evidence_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  thread         ForumThread              @relation(fields: [threadId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  principal      ForumPrincipal           @relation(fields: [principalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  legacyEvidence MigrationLegacyEvidence? @relation(fields: [legacyEvidenceId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([threadId, principalId])
  @@map("forum_participations")
}

model ForumWatchSubscription {
  id               String    @id @default(uuid()) @db.Uuid
  threadId         String    @map("thread_id") @db.Uuid
  principalId      String    @map("principal_id") @db.Uuid
  state            String
  source           String
  provenance       String
  startedAt        DateTime? @map("started_at") @db.Timestamptz(3)
  endedAt          DateTime? @map("ended_at") @db.Timestamptz(3)
  legacyEvidenceId String?   @map("legacy_evidence_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  thread         ForumThread              @relation(fields: [threadId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  principal      ForumPrincipal           @relation(fields: [principalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  legacyEvidence MigrationLegacyEvidence? @relation(fields: [legacyEvidenceId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("forum_watch_subscriptions")
}

model ForumReadState {
  threadId         String    @map("thread_id") @db.Uuid
  principalId      String    @map("principal_id") @db.Uuid
  state            String
  lastReadSeq      Int?      @map("last_read_seq")
  lastReadAt       DateTime? @map("last_read_at") @db.Timestamptz(3)
  provenance       String
  legacyEvidenceId String?   @map("legacy_evidence_id") @db.Uuid
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  thread         ForumThread              @relation(fields: [threadId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  principal      ForumPrincipal           @relation(fields: [principalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  legacyEvidence MigrationLegacyEvidence? @relation(fields: [legacyEvidenceId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([threadId, principalId])
  @@map("forum_read_states")
}

model ForumMention {
  id                   String   @id @default(uuid()) @db.Uuid
  messageId            String   @map("message_id") @db.Uuid
  mentionedPrincipalId String   @map("mentioned_principal_id") @db.Uuid
  sourceAgentId        String?  @map("source_agent_id")
  createdAt            DateTime @map("created_at") @db.Timestamptz(3)

  message            ForumThreadMessage @relation(fields: [messageId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  mentionedPrincipal ForumPrincipal     @relation(fields: [mentionedPrincipalId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([messageId, mentionedPrincipalId])
  @@map("forum_mentions")
}

model ForumNotificationFact {
  id                   String   @id @default(uuid()) @db.Uuid
  recipientPrincipalId String   @map("recipient_principal_id") @db.Uuid
  threadId             String   @map("thread_id") @db.Uuid
  messageId            String?  @map("message_id") @db.Uuid
  reactionId           String?  @map("reaction_id") @db.Uuid
  reason               String
  sourceEventKey       String   @map("source_event_key")
  createdAt            DateTime @map("created_at") @db.Timestamptz(3)

  recipientPrincipal ForumPrincipal      @relation(fields: [recipientPrincipalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  thread             ForumThread         @relation(fields: [threadId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  message            ForumThreadMessage? @relation(fields: [messageId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reaction           ForumReaction?      @relation(fields: [reactionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([recipientPrincipalId, sourceEventKey])
  @@map("forum_notification_facts")
}

// ─── Phase 2 lifecycle storage (empty; no runtime readers/writers) ───────

model ForumThreadRevision {
  id                    String    @id @default(uuid()) @db.Uuid
  threadId              String    @map("thread_id") @db.Uuid
  revision              Int
  discussionState       String    @map("discussion_state")
  openedAt              DateTime  @map("opened_at") @db.Timestamptz(3)
  openedByPrincipalId   String    @map("opened_by_principal_id") @db.Uuid
  resolvedAt            DateTime? @map("resolved_at") @db.Timestamptz(3)
  resolvedByPrincipalId String?   @map("resolved_by_principal_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  thread              ForumThread     @relation("ForumThreadRevisions", fields: [threadId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  openedByPrincipal   ForumPrincipal  @relation("ForumThreadRevisionOpenedBy", fields: [openedByPrincipalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resolvedByPrincipal ForumPrincipal? @relation("ForumThreadRevisionResolvedBy", fields: [resolvedByPrincipalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  currentForThreads   ForumThread[]   @relation("ForumThreadCurrentRevision")

  @@unique([threadId, revision])
  @@map("forum_thread_revisions")
}

// ─── Forum Audit Event (append-only evidence storage) ──────────────────────
//
// INV-AGENT-FORUM-ADDITIVE-STORAGE-DESIGN-V1 §8.3 K. Append-only: UPDATE and
// DELETE are rejected by forum_audit_events_append_only_tg (SQL-016); the
// forum_app role holds only SELECT/INSERT (SQL-017). actorPrincipalId may be
// NULL only for system migration/constraint events, which must be explained
// by provenance. authSubject/agentId/clientId are authentication-context
// snapshots only: they grant no authority and never replace actorPrincipalId.
// payload is bounded, allowlisted metadata only — never tokens, Authorization
// headers, secrets, or full sensitive legacy rows. No runtime writer exists in
// Phase 2; the table is created empty.

model ForumAuditEvent {
  eventId              String   @id @default(uuid()) @map("event_id") @db.Uuid
  eventType            String   @map("event_type")
  actorPrincipalId     String?  @map("actor_principal_id") @db.Uuid
  authSubject          String?  @map("auth_subject")
  agentId              String?  @map("agent_id")
  clientId             String?  @map("client_id")
  targetType           String   @map("target_type")
  targetId             String?  @map("target_id") @db.Uuid
  threadId             String?  @map("thread_id") @db.Uuid
  revision             Int?
  requestCorrelationId String?  @map("request_correlation_id")
  idempotencyKey       String?  @map("idempotency_key")
  payload              Json     @default("{}")
  provenance           String
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actorPrincipal ForumPrincipal? @relation(fields: [actorPrincipalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  thread         ForumThread?    @relation(fields: [threadId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("forum_audit_events")
}
